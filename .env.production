PORT=5000
NODE_ENV=production

# MongoDB Production URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/skillbridge_ai?retryWrites=true&w=majority

# Optional Redis Cache URL
REDIS_URL=redis://localhost:6379

# JWT Secrets (Minimum 32 random characters)
JWT_SECRET=super_secret_jwt_access_key_skillbridge_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_skillbridge_2026

# Client Origin
CLIENT_URL=https://skillbridge.ai

# AI Service Config
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SHARED_SECRET=skillbridge_secret_ai_key_2026

# Cloudinary Integration (Optional for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP Config (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@skillbridge.ai
SMTP_PASS=your_email_password
