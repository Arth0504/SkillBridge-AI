# SkillBridge AI Environment Variables Template
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, Local in Development)
MONGODB_URI=your_mongodb_atlas_uri
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/skillbridge_test

# Authentication Keys
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Frontend & External Services
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SHARED_SECRET=your_ai_service_secret_here
