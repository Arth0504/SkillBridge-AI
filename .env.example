# SkillBridge AI Production Environment Variables Blueprint

# Server Environment Configuration
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://localhost:27017/skillbridge
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=production_jwt_super_secret_key_skillbridge_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=production_refresh_secret_key_skillbridge_2026
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=production_cookie_secret_key_2026

# Client & CORS Origin
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# AI Microservice Gateway
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=YOUR_GEMINI_PROD_API_KEY

# Email SMTP Settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
EMAIL_FROM=no-reply@skillbridge.ai
